{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "registry": {
          "type": "string"
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "imageRegistry": {
          "type": "string"
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseURL": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "apiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceAccountToken": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "audience": {
                  "type": "string"
                },
                "expirationSeconds": {
                  "type": "integer",
                  "minimum": 600
                }
              }
            },
            "csiKey": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitlab",
            "gitea",
            "bitbucket",
            "bitbucketcloud",
            "stash",
            "bitbucketserver",
            "gogs",
            "azure"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "cloneBaseURL": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "authorName": {
          "type": "string"
        },
        "authorEmail": {
          "type": "string"
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceAccountToken": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "audience": {
                  "type": "string"
                },
                "expirationSeconds": {
                  "type": "integer",
                  "minimum": 600
                }
              }
            },
            "csiKey": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^/\\s]+(/[^/\\s]+)+$"
      }
    },
    "namespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
      },
      "uniqueItems": true
    },
    "dryRun": {
      "type": "boolean"
    },
    "mode": {
      "enum": ["safe", "full", "yolo"]
    },
    "playbooks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,50}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "suspend": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "schedule": {
                "type": "string",
                "minLength": 1
              },
              "webhook": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,50}[a-z0-9])?$"
              },
              "manual": {
                "type": "boolean",
                "const": true
              }
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "repos": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^/\\s]+(/[^/\\s]+)+$"
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "enum": [
              "pr",
              "report"
            ]
          },
          "mode": {
            "enum": ["safe", "full", "yolo"]
          },
          "guardrails": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxPRs": {
                "type": "integer",
                "minimum": 0
              },
              "dryRun": {
                "type": "boolean"
              },
              "maxFileBytes": {
                "type": "integer",
                "minimum": 1
              },
              "maxIssues": {
                "type": "integer",
                "minimum": 0
              },
              "writePaths": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "denyPaths": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "reopenAfter": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$|^0$"
              }
            }
          },
          "jiraProjects": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "jiraReadSpaces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "confluenceSpaces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^~?[A-Za-z0-9_]+$"
            }
          }
        },
        "if": {
          "properties": {
            "enabled": {
              "const": false
            }
          },
          "required": [
            "enabled"
          ]
        },
        "else": {
          "required": [
            "trigger",
            "tools",
            "prompt"
          ]
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        },
        "workspaceSizeLimit": {
          "type": "string"
        },
        "cronJob": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concurrencyPolicy": {
              "enum": [
                "Forbid",
                "Allow",
                "Replace"
              ]
            },
            "successfulJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "failedJobsHistoryLimit": {
              "type": "integer",
              "minimum": 0
            },
            "startingDeadlineSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "timeZone": {
              "type": "string"
            },
            "suspend": {
              "type": "boolean"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "extraContainers": {
          "type": "array"
        },
        "initContainers": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "maxConcurrentJobs": {
          "type": "integer",
          "minimum": 0
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1032192
        },
        "hooks": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "auth": {
                "enum": [
                  "token",
                  "hmac-sha256"
                ]
              },
              "header": {
                "type": "string"
              },
              "secret": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "serviceAccountToken": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "audience": {
                        "type": "string"
                      },
                      "expirationSeconds": {
                        "type": "integer",
                        "minimum": 600
                      }
                    }
                  },
                  "csiKey": {
                    "type": "string"
                  },
                  "existingSecret": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array"
            },
            "tls": {
              "type": "array"
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "extraContainers": {
          "type": "array"
        },
        "initContainers": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "object"
        },
        "startupProbe": {
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "enum": [
              "deploy",
              "dependency",
              "external"
            ]
          },
          "url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "transport": {
            "enum": [
              "streamable",
              "sse"
            ]
          },
          "allowTools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "denyTools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "timeout": {
            "type": "string",
            "pattern": "^[0-9]+(ms|s|m|h)$"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "secretHeaders": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "serviceAccountToken": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "audience": {
                      "type": "string"
                    },
                    "expirationSeconds": {
                      "type": "integer",
                      "minimum": 600
                    }
                  }
                },
                "csiKey": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "prefix": {
                  "type": "string"
                }
              }
            }
          },
          "deploy": {
            "type": "object",
            "properties": {
              "image": {
                "type": "object",
                "required": [
                  "repository"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tag": {
                    "type": "string"
                  },
                  "digest": {
                    "type": "string"
                  },
                  "pullPolicy": {
                    "type": "string"
                  },
                  "registry": {
                    "type": "string"
                  }
                }
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "command": {
                "type": "array"
              },
              "args": {
                "type": "array"
              },
              "env": {
                "type": "array"
              },
              "envFrom": {
                "type": "array"
              },
              "replicas": {
                "type": "integer",
                "minimum": 0
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "filesMountPath": {
                "type": "string"
              },
              "secretEnv": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "existingSecret": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "rbac": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "clusterRules": {
                    "type": "array"
                  },
                  "rules": {
                    "type": "array"
                  }
                }
              },
              "readinessProbe": {
                "type": "object"
              },
              "livenessProbe": {
                "type": "object"
              },
              "resources": {
                "type": "object"
              },
              "podAnnotations": {
                "type": "object"
              },
              "podLabels": {
                "type": "object"
              },
              "podSecurityContext": {
                "type": "object"
              },
              "securityContext": {
                "type": "object"
              },
              "extraEnv": {
                "type": "array"
              },
              "extraEnvFrom": {
                "type": "array"
              },
              "extraVolumes": {
                "type": "array"
              },
              "extraVolumeMounts": {
                "type": "array"
              },
              "extraContainers": {
                "type": "array"
              },
              "initContainers": {
                "type": "array"
              },
              "nodeSelector": {
                "type": "object"
              },
              "tolerations": {
                "type": "array"
              },
              "affinity": {
                "type": "object"
              },
              "topologySpreadConstraints": {
                "type": "array"
              },
              "priorityClassName": {
                "type": "string"
              },
              "serviceAccount": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "create": {
                    "type": "boolean"
                  },
                  "name": {
                    "type": "string"
                  },
                  "annotations": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                },
                "mode": {
                  "const": "deploy"
                }
              },
              "required": [
                "enabled",
                "mode"
              ]
            },
            "then": {
              "required": [
                "deploy"
              ],
              "properties": {
                "deploy": {
                  "required": [
                    "image",
                    "port"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                },
                "mode": {
                  "enum": [
                    "external",
                    "dependency"
                  ]
                }
              },
              "required": [
                "enabled",
                "mode"
              ]
            },
            "then": {
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "grafana-mcp": {
      "type": "object"
    },
    "litellm": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayIngressFrom": {
          "type": "array"
        },
        "workerEgress": {
          "type": "array"
        }
      }
    },
    "resourceQuota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "jobs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "namespaceOverride": {
      "type": "string"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "csi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretProviderClass": {
              "type": "string"
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "secretProviderClass": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
